{
  "name": "@cbhasib/devpilot",
  "version": "0.7.1",
  "description": "Reusable project management CLI for multi-service development workspaces.",
  "author": "Hasibul Hasan <cbHasib>",
  "license": "MIT",
  "homepage": "https://github.com/cbHasib/devpilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbHasib/devpilot.git"
  },
  "bugs": {
    "url": "https://github.com/cbHasib/devpilot/issues"
  },
  "bin": {
    "devpilot": "bin/devpilot.js"
  },
  "main": "dist/cli.js",
  "types": "dist/types.d.ts",
  "files": [
    "bin",
    "dist",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run build && node --check bin/devpilot.js && node -e \"require('./dist/cli')\"",
    "start": "npm run build && node bin/devpilot.js",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "workspace",
    "monorepo",
    "services"
  ],
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^6.0.3"
  }
}
